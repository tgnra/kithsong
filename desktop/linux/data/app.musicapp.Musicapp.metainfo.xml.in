<?xml version="1.0" encoding="UTF-8"?>
<!-- Configured by CMake with the release's version and build date. -->
<component type="desktop-application">
  <id>app.musicapp.Musicapp</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>musicapp</name>
  <summary>Music library, player and LAN sync</summary>
  <description>
    <p>
      A music library manager and player. It autotags your collection against MusicBrainz
      and keeps every device in sync over the local network, with no server and no cloud.
    </p>
  </description>
  <launchable type="desktop-id">app.musicapp.Musicapp.desktop</launchable>
  <developer id="app.musicapp">
    <name>musicapp</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
    <release version="@PROJECT_VERSION@" date="@MUSICAPP_RELEASE_DATE@"/>
  </releases>
</component>
