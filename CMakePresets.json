{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (llvm-mingw)",
      "inherits": "windows",
      "toolchainFile": "${sourceDir}/cmake/toolchain-windows-x64.cmake"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 (llvm-mingw, release)",
      "inherits": "windows-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows on Arm (llvm-mingw)",
      "inherits": "windows",
      "toolchainFile": "${sourceDir}/cmake/toolchain-windows-arm64.cmake"
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Windows on Arm (llvm-mingw, release)",
      "inherits": "windows-arm64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-gtk",
      "displayName": "Linux (GTK4)",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-gtk-release",
      "displayName": "Linux (GTK4, release)",
      "inherits": "linux-gtk",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "jobs": 8 },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "jobs": 8 },
    { "name": "windows-arm64", "configurePreset": "windows-arm64", "jobs": 8 },
    { "name": "windows-arm64-release", "configurePreset": "windows-arm64-release", "jobs": 8 },
    { "name": "linux-gtk", "configurePreset": "linux-gtk" },
    { "name": "linux-gtk-release", "configurePreset": "linux-gtk-release" }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } },
    { "name": "windows-arm64", "configurePreset": "windows-arm64", "output": { "outputOnFailure": true } },
    { "name": "linux-gtk", "configurePreset": "linux-gtk", "output": { "outputOnFailure": true } }
  ]
}
