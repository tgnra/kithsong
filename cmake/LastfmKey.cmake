# The build's Last.fm API key and shared secret, written to a generated header obscured: each
# is XORed with a random mask made once per build directory, and split into its even and odd
# bytes, so neither shows up as a string in the binary (`strings`, a hex editor). That's
# obscurity, not protection: the core has to decode them to sign requests, and anyone with
# the binary and a debugger can do the same. Last.fm accepts that for desktop apps.
#
# The values come from the first of:
#   1. the cache variables KITHSONG_LASTFM_KEY and KITHSONG_LASTFM_SECRET (-D, presets);
#   2. the environment variables of the same names (the release scripts and CI);
#   3. the file KITHSONG_LASTFM_FILE, by default last.fm.api at the top of the source tree
#      (gitignored): the text of Last.fm's API account page, with an "API key <hex>" and a
#      "Shared secret <hex>" line.
# Set both or neither: one alone turns Last.fm off with a warning. See docs/api-keys.md.

# Hex bytes of s XORed with the mask, as two C initialisers: the even bytes into even_var and
# the odd ones into odd_var ("0" for none, as C has no empty initialisers).
function(_kithsong_lastfm_mask s mask even_var odd_var)
  string(HEX "${s}" hex)
  string(LENGTH "${hex}" hex_len)
  string(LENGTH "${mask}" mask_len)
  set(even "")
  set(odd "")
  set(i 0)
  set(pos 0)
  while(pos LESS hex_len)
    math(EXPR mpos "(${pos} % ${mask_len})")
    string(SUBSTRING "${hex}" ${pos} 2 c)
    string(SUBSTRING "${mask}" ${mpos} 2 m)
    math(EXPR v "0x${c} ^ 0x${m}" OUTPUT_FORMAT HEXADECIMAL)
    math(EXPR parity "${i} % 2")
    if(parity)
      string(APPEND odd "${v}, ")
    else()
      string(APPEND even "${v}, ")
    endif()
    math(EXPR i "${i} + 1")
    math(EXPR pos "${pos} + 2")
  endwhile()
  if(even STREQUAL "")
    set(even "0")
  endif()
  if(odd STREQUAL "")
    set(odd "0")
  endif()
  set(${even_var} "${even}" PARENT_SCOPE)
  set(${odd_var} "${odd}" PARENT_SCOPE)
endfunction()

function(kithsong_lastfm_key_header out)
  set(key "${KITHSONG_LASTFM_KEY}")
  set(secret "${KITHSONG_LASTFM_SECRET}")
  set(from "-DKITHSONG_LASTFM_KEY/SECRET")
  if(key STREQUAL "" AND secret STREQUAL "" AND DEFINED ENV{KITHSONG_LASTFM_KEY})
    set(key "$ENV{KITHSONG_LASTFM_KEY}")
    set(secret "$ENV{KITHSONG_LASTFM_SECRET}")
    set(from "the environment")
  endif()
  if(key STREQUAL "" AND secret STREQUAL "" AND NOT KITHSONG_LASTFM_FILE STREQUAL ""
     AND EXISTS "${KITHSONG_LASTFM_FILE}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KITHSONG_LASTFM_FILE}")
    file(READ "${KITHSONG_LASTFM_FILE}" text)
    if(text MATCHES "API key[ \t:=]*([0-9A-Fa-f]+)")
      set(key "${CMAKE_MATCH_1}")
    endif()
    if(text MATCHES "Shared secret[ \t:=]*([0-9A-Fa-f]+)")
      set(secret "${CMAKE_MATCH_1}")
    endif()
    set(from "${KITHSONG_LASTFM_FILE}")
  endif()
  string(STRIP "${key}" key)
  string(STRIP "${secret}" secret)
  if(key STREQUAL "" OR secret STREQUAL "")
    if(NOT key STREQUAL "" OR NOT secret STREQUAL "")
      message(WARNING "Only one of the Last.fm API key and shared secret is set (from ${from}); "
                      "scrobbling to Last.fm is off in this build.")
    endif()
    set(key "")
    set(secret "")
    message(STATUS "Last.fm: no API key; scrobbling to Last.fm is off in this build")
  else()
    message(STATUS "Last.fm: API key from ${from}")
  endif()

  # Made once per build directory, so reconfiguring doesn't rebuild the scrobbler.
  if(NOT DEFINED CACHE{_KITHSONG_LASTFM_MASK})
    string(RANDOM LENGTH 128 ALPHABET "0123456789abcdef" mask)
    set(_KITHSONG_LASTFM_MASK "${mask}" CACHE INTERNAL "XOR mask for the Last.fm key in lastfm_key.h")
  endif()
  set(mask "${_KITHSONG_LASTFM_MASK}")
  _kithsong_lastfm_mask("${key}" "${mask}" key_even key_odd)
  _kithsong_lastfm_mask("${secret}" "${mask}" secret_even secret_odd)
  string(LENGTH "${key}" key_len)
  string(LENGTH "${secret}" secret_len)
  string(REGEX REPLACE "(..)" "0x\\1, " mask_bytes "${mask}")

  file(CONFIGURE OUTPUT "${out}" CONTENT [[
/* Generated by cmake/LastfmKey.cmake - do not edit, never commit. The build's Last.fm API key
 * and secret, XORed with k_lastfm_mask and split into even and odd bytes; empty when the build
 * has none. Obscurity only, so they don't show in `strings`: see lastfm_key.c. */
#define MC_LASTFM_KEY_LEN @key_len@
#define MC_LASTFM_SECRET_LEN @secret_len@
static const unsigned char k_lastfm_key_even[] = {@key_even@};
static const unsigned char k_lastfm_secret_odd[] = {@secret_odd@};
static const unsigned char k_lastfm_mask[] = {@mask_bytes@};
static const unsigned char k_lastfm_secret_even[] = {@secret_even@};
static const unsigned char k_lastfm_key_odd[] = {@key_odd@};
]] @ONLY)
endfunction()
