# Script mode: cmake -DIN=<strings/en.json> -DOUT_DIR=<dir> -DMODE=c|android -P gen_strings.cmake
#
# Turns the UI strings in strings/*.json (see strings/README.md) into code for each platform.
# IN is the English file; every other <lang>.json next to it is a translation.
#   MODE=c        OUT_DIR/mc_strings_gen.h: enum mc_str_id, one id per string of every
#                 section; OUT_DIR/mc_strings_gen.c: a table per language (util/i18n_table.h).
#   MODE=android  OUT_DIR/values/strings.xml, and values-<lang>/strings.xml per translation:
#                 the shared and android sections as Android string and plurals resources.
# Fails on anything malformed rather than writing something half right: unknown sections or
# fields, keys that aren't snake_case or appear twice, bad placeholders, plurals without
# "other", and translations of strings English doesn't have.
cmake_minimum_required(VERSION 3.28)

foreach(_v IN ITEMS IN OUT_DIR MODE)
  if(NOT DEFINED ${_v})
    message(FATAL_ERROR "gen_strings: -D${_v}=... is required")
  endif()
endforeach()
if(NOT MODE MATCHES "^(c|android)$")
  message(FATAL_ERROR "gen_strings: MODE must be c or android, not '${MODE}'")
endif()

set(SECTIONS shared linux windows android)
# Stand-ins while rewriting text; CMake strings have no escape for control characters.
string(ASCII 1 SOH)
string(ASCII 2 STX)
set(PLURAL_CATS zero one two few many other)
set(FIELDS text note translatable ${PLURAL_CATS})

# --- Reading and checking ---------------------------------------------------------------

# Checks the placeholders in str: {N} or {N:d}, with {{ and }} for literal braces. Sets
# <out>_INDEXES to the indexes used and <out>_TYPES to "N:s" / "N:d" pairs.
function(check_placeholders str where out)
  string(REPLACE "{{" "" rest "${str}")
  string(REPLACE "}}" "" rest "${rest}")
  string(REGEX MATCHALL "{[0-9]+(:d)?}" found "${rest}")
  string(REGEX REPLACE "{[0-9]+(:d)?}" "" rest "${rest}")
  if(rest MATCHES "[{}]")
    message(FATAL_ERROR "gen_strings: ${where}: malformed placeholder in \"${str}\" "
                        "(use {0}, {0:d}, and {{ or }} for a literal brace)")
  endif()
  set(indexes "")
  set(types "")
  foreach(p IN LISTS found)
    string(REGEX REPLACE "^{([0-9]+).*" "\\1" i "${p}")
    if(p MATCHES ":d}$")
      set(t "${i}:d")
    else()
      set(t "${i}:s")
    endif()
    # The same index twice must be the same type.
    foreach(other IN LISTS types)
      if(other MATCHES "^${i}:" AND NOT other STREQUAL t)
        message(FATAL_ERROR "gen_strings: ${where}: {${i}} is used as both a string and {${i}:d}")
      endif()
    endforeach()
    list(APPEND indexes "${i}")
    list(APPEND types "${t}")
  endforeach()
  list(REMOVE_DUPLICATES indexes)
  list(REMOVE_DUPLICATES types)
  set(${out}_INDEXES "${indexes}" PARENT_SCOPE)
  set(${out}_TYPES "${types}" PARENT_SCOPE)
endfunction()

# Reads one entry's JSON value (json, of the given type) into variables prefixed pfx:
# pfx_TEXT, pfx_NOTE, pfx_TRANSLATABLE, pfx_PLURAL, pfx_<category> for plurals, and
# pfx_HAS_TEXT / pfx_HAS_<category> for the forms given.
function(read_entry json type where pfx)
  set(text "")
  set(note "")
  set(translatable ON)
  set(plural OFF)
  set(has_text OFF)
  foreach(c IN LISTS PLURAL_CATS)
    set(form_${c} "")
    set(has_${c} OFF)
  endforeach()
  if(type STREQUAL "STRING")
    set(text "${json}")
    set(has_text ON)
  elseif(type STREQUAL "OBJECT")
    string(JSON n LENGTH "${json}")
    if(n EQUAL 0)
      message(FATAL_ERROR "gen_strings: ${where}: empty object")
    endif()
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON f MEMBER "${json}" ${i})
      if(NOT f IN_LIST FIELDS)
        message(FATAL_ERROR "gen_strings: ${where}: unknown field \"${f}\" "
                            "(expected one of: ${FIELDS})")
      endif()
      string(JSON ft TYPE "${json}" "${f}")
      string(JSON fv GET "${json}" "${f}")
      if(f STREQUAL "translatable")
        if(NOT ft STREQUAL "BOOLEAN")
          message(FATAL_ERROR "gen_strings: ${where}: \"translatable\" must be true or false")
        endif()
        set(translatable ${fv})
      elseif(NOT ft STREQUAL "STRING")
        message(FATAL_ERROR "gen_strings: ${where}: \"${f}\" must be a string")
      elseif(f STREQUAL "text")
        set(text "${fv}")
        set(has_text ON)
      elseif(f STREQUAL "note")
        set(note "${fv}")
      else()
        set(form_${f} "${fv}")
        set(has_${f} ON)
        set(plural ON)
      endif()
    endforeach()
  else()
    message(FATAL_ERROR "gen_strings: ${where}: must be a string or an object, not ${type}")
  endif()
  if(plural AND has_text)
    message(FATAL_ERROR "gen_strings: ${where}: has both \"text\" and plural forms")
  endif()
  if(plural AND NOT has_other)
    message(FATAL_ERROR "gen_strings: ${where}: a plural needs an \"other\" form")
  endif()
  if(NOT plural AND NOT has_text)
    message(FATAL_ERROR "gen_strings: ${where}: has no \"text\" (or plural forms)")
  endif()
  set(${pfx}_TEXT "${text}" PARENT_SCOPE)
  set(${pfx}_NOTE "${note}" PARENT_SCOPE)
  set(${pfx}_TRANSLATABLE ${translatable} PARENT_SCOPE)
  set(${pfx}_PLURAL ${plural} PARENT_SCOPE)
  set(${pfx}_HAS_TEXT ${has_text} PARENT_SCOPE)
  foreach(c IN LISTS PLURAL_CATS)
    set(${pfx}_${c} "${form_${c}}" PARENT_SCOPE)
    set(${pfx}_HAS_${c} ${has_${c}} PARENT_SCOPE)
  endforeach()
endfunction()

# Counts how often "key": appears in raw, the file's text, to catch keys given twice in one
# object (the JSON parser silently keeps one of them).
function(check_unique_in_file raw key file)
  string(REGEX MATCHALL "\"${key}\"[ \t\r\n]*:" hits "${raw}")
  list(LENGTH hits n)
  if(n GREATER 1)
    message(FATAL_ERROR "gen_strings: ${file}: key \"${key}\" appears ${n} times")
  endif()
endfunction()

get_filename_component(STRINGS_DIR "${IN}" DIRECTORY)
get_filename_component(BASE_LANG "${IN}" NAME_WE)
if(NOT BASE_LANG STREQUAL "en")
  message(FATAL_ERROR "gen_strings: IN must be the English en.json, not ${IN}")
endif()

file(READ "${IN}" EN_RAW)
string(JSON _t ERROR_VARIABLE _err TYPE "${EN_RAW}")
if(_err)
  message(FATAL_ERROR "gen_strings: ${IN}: ${_err}")
endif()

# IDS: every string, in file order, as section/key. Per id: ID_<id>_SECTION, _KEY, _ENUM
# and the entry's fields under EN_<id>.
set(IDS "")
set(ALL_KEYS "")
string(JSON _nsec LENGTH "${EN_RAW}")
math(EXPR _last_sec "${_nsec} - 1")
foreach(_s RANGE ${_last_sec})
  string(JSON _sec MEMBER "${EN_RAW}" ${_s})
  if(NOT _sec IN_LIST SECTIONS)
    message(FATAL_ERROR "gen_strings: ${IN}: unknown section \"${_sec}\" (expected: ${SECTIONS})")
  endif()
endforeach()
foreach(_sec IN LISTS SECTIONS)
  string(JSON _secjson ERROR_VARIABLE _err GET "${EN_RAW}" "${_sec}")
  if(_err)
    continue() # a section may be absent
  endif()
  string(JSON _n LENGTH "${_secjson}")
  if(_n EQUAL 0)
    continue()
  endif()
  math(EXPR _last "${_n} - 1")
  foreach(_i RANGE ${_last})
    string(JSON _key MEMBER "${_secjson}" ${_i})
    if(NOT _key MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "gen_strings: ${IN}: key \"${_sec}.${_key}\" must be snake_case")
    endif()
    if(_key IN_LIST FIELDS)
      message(FATAL_ERROR "gen_strings: ${IN}: \"${_key}\" is a field name and can't be a key")
    endif()
    if(_key IN_LIST ALL_KEYS)
      message(FATAL_ERROR "gen_strings: ${IN}: key \"${_key}\" is in more than one section; "
                          "keys must be unique across sections")
    endif()
    list(APPEND ALL_KEYS "${_key}")
    set(_id "${_sec}.${_key}")
    list(APPEND IDS "${_id}")
    set(ID_${_id}_SECTION "${_sec}")
    set(ID_${_id}_KEY "${_key}")
    string(TOUPPER "${_key}" _ukey)
    string(TOUPPER "${_sec}" _usec)
    if(_sec STREQUAL "shared")
      set(ID_${_id}_ENUM "MC_STR_${_ukey}")
    else()
      set(ID_${_id}_ENUM "MC_STR_${_usec}_${_ukey}")
    endif()

    string(JSON _ty TYPE "${_secjson}" "${_key}")
    string(JSON _val GET "${_secjson}" "${_key}")
    read_entry("${_val}" "${_ty}" "${IN}: ${_id}" EN_${_id})

    # Placeholders: the text, or the "other" form, decides what a string takes. Every index
    # from 0 up must be used (in some form), and the other forms may use no others.
    if(EN_${_id}_PLURAL)
      set(_forms "")
      foreach(_c IN LISTS PLURAL_CATS)
        if(EN_${_id}_HAS_${_c})
          list(APPEND _forms "${_c}")
        endif()
      endforeach()
    else()
      set(_forms TEXT)
    endif()
    set(_types "")
    set(_indexes "")
    foreach(_c IN LISTS _forms)
      check_placeholders("${EN_${_id}_${_c}}" "${IN}: ${_id}" _ph)
      list(APPEND _types ${_ph_TYPES})
      list(APPEND _indexes ${_ph_INDEXES})
    endforeach()
    list(REMOVE_DUPLICATES _types)
    list(REMOVE_DUPLICATES _indexes)
    list(LENGTH _indexes _count)
    foreach(_ix IN LISTS _indexes)
      if(_ix GREATER_EQUAL _count)
        message(FATAL_ERROR "gen_strings: ${IN}: ${_id}: placeholders must be numbered from {0} "
                            "with no gaps")
      endif()
      foreach(_t IN LISTS _types)
        foreach(_t2 IN LISTS _types)
          if(_t MATCHES "^${_ix}:" AND _t2 MATCHES "^${_ix}:" AND NOT _t STREQUAL _t2)
            message(FATAL_ERROR "gen_strings: ${IN}: ${_id}: {${_ix}} has different types in "
                                "different plural forms")
          endif()
        endforeach()
      endforeach()
    endforeach()
    set(EN_${_id}_TYPES "${_types}")
  endforeach()
endforeach()

# A key given twice in one object (the cross-section case is caught above).
foreach(_key IN LISTS ALL_KEYS)
  check_unique_in_file("${EN_RAW}" "${_key}" "${IN}")
endforeach()

# Translations: every other <lang>.json, with the same sections and keys as English (any
# subset of them).
file(GLOB _lang_files "${STRINGS_DIR}/*.json")
list(SORT _lang_files)
set(LANGS "")
foreach(_file IN LISTS _lang_files)
  get_filename_component(_lang "${_file}" NAME_WE)
  if(_lang STREQUAL "en")
    continue()
  endif()
  if(NOT _lang MATCHES "^[a-z][a-z][a-z]?(-[A-Za-z0-9]+)*$")
    message(FATAL_ERROR "gen_strings: ${_file}: the file name must be a BCP 47 tag such as fr "
                        "or pt-BR")
  endif()
  list(APPEND LANGS "${_lang}")
  set(LANG_${_lang}_IDS "")
  file(READ "${_file}" _raw)
  string(JSON _t ERROR_VARIABLE _err TYPE "${_raw}")
  if(_err)
    message(FATAL_ERROR "gen_strings: ${_file}: ${_err}")
  endif()
  string(JSON _nsec LENGTH "${_raw}")
  if(_nsec EQUAL 0)
    continue()
  endif()
  math(EXPR _last_sec "${_nsec} - 1")
  foreach(_s RANGE ${_last_sec})
    string(JSON _sec MEMBER "${_raw}" ${_s})
    if(NOT _sec IN_LIST SECTIONS)
      message(FATAL_ERROR "gen_strings: ${_file}: unknown section \"${_sec}\"")
    endif()
    string(JSON _secjson GET "${_raw}" "${_sec}")
    string(JSON _n LENGTH "${_secjson}")
    if(_n EQUAL 0)
      continue()
    endif()
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE ${_last})
      string(JSON _key MEMBER "${_secjson}" ${_i})
      set(_id "${_sec}.${_key}")
      if(NOT _id IN_LIST IDS)
        message(FATAL_ERROR "gen_strings: ${_file}: \"${_id}\" isn't in en.json")
      endif()
      check_unique_in_file("${_raw}" "${_key}" "${_file}")
      if(NOT EN_${_id}_TRANSLATABLE)
        message(FATAL_ERROR "gen_strings: ${_file}: \"${_id}\" is marked translatable: false")
      endif()
      string(JSON _ty TYPE "${_secjson}" "${_key}")
      string(JSON _val GET "${_secjson}" "${_key}")
      set(_p L_${_lang}_${_id})
      read_entry("${_val}" "${_ty}" "${_file}: ${_id}" ${_p})
      if(NOT ${_p}_PLURAL STREQUAL EN_${_id}_PLURAL)
        message(FATAL_ERROR "gen_strings: ${_file}: \"${_id}\" must be a plural exactly when "
                            "the English one is")
      endif()
      foreach(_c IN ITEMS TEXT ${PLURAL_CATS})
        if(${_p}_HAS_${_c})
          check_placeholders("${${_p}_${_c}}" "${_file}: ${_id}" _ph)
          foreach(_t IN LISTS _ph_TYPES)
            if(NOT _t IN_LIST EN_${_id}_TYPES)
              string(REGEX REPLACE ":s$" "" _t "${_t}")
              message(FATAL_ERROR "gen_strings: ${_file}: \"${_id}\" uses {${_t}}, which the "
                                  "English string doesn't take")
            endif()
          endforeach()
        endif()
      endforeach()
      list(APPEND LANG_${_lang}_IDS "${_id}")
    endforeach()
  endforeach()
endforeach()

# --- Writing ------------------------------------------------------------------------------

# Writes content to path only if it changed, so unchanged output doesn't trigger rebuilds.
function(write_if_changed path content)
  set(tmp "${path}.tmp")
  file(WRITE "${tmp}" "${content}")
  file(COPY_FILE "${tmp}" "${path}" ONLY_IF_DIFFERENT)
  file(REMOVE "${tmp}")
endfunction()

# The text without its mnemonic marker: "S_kip" -> "Skip", "a__b" -> "a_b".
function(strip_mnemonic str out)
  string(REPLACE "__" "${SOH}" s "${str}")
  string(REPLACE "_" "" s "${s}")
  string(REPLACE "${SOH}" "_" s "${s}")
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

function(c_literal str out)
  string(REPLACE "\\" "\\\\" s "${str}")
  string(REPLACE "\"" "\\\"" s "${s}")
  string(REPLACE "\n" "\\n" s "${s}")
  string(REPLACE "\r" "\\r" s "${s}")
  string(REPLACE "\t" "\\t" s "${s}")
  string(REPLACE "??" "?\\?" s "${s}") # no trigraphs
  set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

# One mc_str_entry initializer for the entry under pfx.
function(c_entry pfx out)
  if(${pfx}_PLURAL)
    c_literal("${${pfx}_other}" text)
    set(mnemonic "NULL")
    # Concatenated rather than a list: the text may contain semicolons.
    set(forms "")
    set(sep "")
    foreach(c IN LISTS PLURAL_CATS)
      if(${pfx}_HAS_${c})
        c_literal("${${pfx}_${c}}" f)
      else()
        set(f "NULL")
      endif()
      string(APPEND forms "${sep}${f}")
      set(sep ", ")
    endforeach()
    set(forms "{${forms}}")
  else()
    strip_mnemonic("${${pfx}_TEXT}" plain)
    c_literal("${plain}" text)
    if(${pfx}_TEXT MATCHES "_")
      c_literal("${${pfx}_TEXT}" mnemonic)
    else()
      set(mnemonic "NULL")
    endif()
    set(forms "{NULL}")
  endif()
  set(${out} "{${text}, ${mnemonic}, ${forms}}" PARENT_SCOPE)
endfunction()

# A string fit for a /* comment */ on one line.
function(c_comment str out)
  string(REGEX REPLACE "[\r\n\t]+" " " s "${str}")
  string(REPLACE "*/" "* /" s "${s}")
  string(LENGTH "${s}" len)
  if(len GREATER 60)
    string(SUBSTRING "${s}" 0 57 s)
    set(s "${s}...")
  endif()
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "c")
  set(h "/* Generated from strings/<lang>.json by cmake/gen_strings.cmake - do not edit. */\n")
  string(APPEND h "#ifndef MC_STRINGS_GEN_H\n#define MC_STRINGS_GEN_H\n\n")
  string(APPEND h "/* One id per UI string: MC_STR_<KEY> for the shared section, "
                  "MC_STR_<SECTION>_<KEY> for the others. */\n")
  string(APPEND h "enum mc_str_id {\n")
  set(_prev_sec "")
  foreach(_id IN LISTS IDS)
    if(NOT ID_${_id}_SECTION STREQUAL _prev_sec)
      set(_prev_sec "${ID_${_id}_SECTION}")
      string(APPEND h "  /* ${_prev_sec} */\n")
    endif()
    if(EN_${_id}_PLURAL)
      c_comment("${EN_${_id}_other}" _cm)
      set(_cm "plural: ${_cm}")
    else()
      c_comment("${EN_${_id}_TEXT}" _cm)
    endif()
    string(APPEND h "  ${ID_${_id}_ENUM}, /* ${_cm} */\n")
  endforeach()
  string(APPEND h "  MC_STR_COUNT\n};\n\n#endif\n")

  set(c "/* Generated from strings/<lang>.json by cmake/gen_strings.cmake - do not edit. */\n")
  string(APPEND c "#include \"util/i18n_table.h\"\n\n")
  string(APPEND c "static const mc_str_entry en[MC_STR_COUNT] = {\n")
  foreach(_id IN LISTS IDS)
    c_entry(EN_${_id} _e)
    string(APPEND c "  [${ID_${_id}_ENUM}] = ${_e},\n")
  endforeach()
  string(APPEND c "};\n")
  set(_langs_init "  {\"en\", en},\n")
  foreach(_lang IN LISTS LANGS)
    string(MAKE_C_IDENTIFIER "lang_${_lang}" _sym)
    string(APPEND c "\n/* ${_lang}: strings left out fall back to English. */\n")
    string(APPEND c "static const mc_str_entry ${_sym}[MC_STR_COUNT] = {\n")
    foreach(_id IN LISTS LANG_${_lang}_IDS)
      c_entry(L_${_lang}_${_id} _e)
      string(APPEND c "  [${ID_${_id}_ENUM}] = ${_e},\n")
    endforeach()
    string(APPEND c "};\n")
    string(APPEND _langs_init "  {\"${_lang}\", ${_sym}},\n")
  endforeach()
  string(APPEND c "\nconst mc_str_lang mc_str_langs[] = {\n${_langs_init}};\n")
  list(LENGTH LANGS _nl)
  math(EXPR _nl "${_nl} + 1")
  string(APPEND c "const int mc_str_lang_count = ${_nl};\n")

  file(MAKE_DIRECTORY "${OUT_DIR}")
  write_if_changed("${OUT_DIR}/mc_strings_gen.h" "${h}")
  write_if_changed("${OUT_DIR}/mc_strings_gen.c" "${c}")
  return()
endif()

# --- Android ------------------------------------------------------------------------------

# The text as an Android string resource: no mnemonic, XML and aapt escapes, and {N} /
# {N:d} as %<N+1>$s / %<N+1>$d.
function(android_text str out)
  strip_mnemonic("${str}" s)
  check_placeholders("${s}" "android" ph)
  string(REPLACE "&" "&amp;" s "${s}")
  string(REPLACE "<" "&lt;" s "${s}")
  string(REPLACE ">" "&gt;" s "${s}")
  string(REPLACE "\\" "\\\\" s "${s}")
  string(REPLACE "'" "\\'" s "${s}")
  string(REPLACE "\"" "\\\"" s "${s}")
  string(REPLACE "\n" "\\n" s "${s}")
  string(REPLACE "\t" "\\t" s "${s}")
  if(NOT "${ph_INDEXES}" STREQUAL "")
    # Formatted with arguments, so a literal % has to be doubled.
    string(REPLACE "%" "%%" s "${s}")
    string(REPLACE "{{" "${SOH}" s "${s}")
    string(REPLACE "}}" "${STX}" s "${s}")
    foreach(i IN LISTS ph_INDEXES)
      math(EXPR n "${i} + 1")
      string(REPLACE "{${i}}" "%${n}$s" s "${s}")
      string(REPLACE "{${i}:d}" "%${n}$d" s "${s}")
    endforeach()
    string(REPLACE "${SOH}" "{" s "${s}")
    string(REPLACE "${STX}" "}" s "${s}")
  else()
    string(REPLACE "{{" "{" s "${s}")
    string(REPLACE "}}" "}" s "${s}")
  endif()
  if(s MATCHES "^[@?]")
    set(s "\\${s}")
  endif()
  # aapt collapses runs of spaces and trims the ends unless the text is quoted.
  if(s MATCHES "^ |  | $")
    set(s "\"${s}\"")
  endif()
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

function(xml_comment str out)
  string(REPLACE "--" "- -" s "${str}")
  string(REPLACE "\n" " " s "${s}")
  set(${out} "    <!-- ${s} -->\n" PARENT_SCOPE)
endfunction()

# The resources for one language: pfx_of is the variable prefix of a language's entry
# minus the id (EN_ or L_<lang>_), ids the ids to write.
function(android_resources pfx_of ids is_base out)
  set(x "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n")
  string(APPEND x "<!-- Generated from strings/<lang>.json by cmake/gen_strings.cmake - do not edit. -->\n")
  string(APPEND x "<resources>\n")
  foreach(id IN LISTS ids)
    if(NOT ID_${id}_SECTION MATCHES "^(shared|android)$")
      continue()
    endif()
    set(p "${pfx_of}${id}")
    set(key "${ID_${id}_KEY}")
    if(NOT "${EN_${id}_NOTE}" STREQUAL "")
      xml_comment("${EN_${id}_NOTE}" cm)
      string(APPEND x "${cm}")
    endif()
    if(EN_${id}_PLURAL)
      string(APPEND x "    <plurals name=\"${key}\">\n")
      foreach(c IN LISTS PLURAL_CATS)
        if(${p}_HAS_${c})
          android_text("${${p}_${c}}" t)
          string(APPEND x "        <item quantity=\"${c}\">${t}</item>\n")
        endif()
      endforeach()
      string(APPEND x "    </plurals>\n")
    else()
      android_text("${${p}_TEXT}" t)
      if(EN_${id}_TRANSLATABLE)
        string(APPEND x "    <string name=\"${key}\">${t}</string>\n")
      else()
        string(APPEND x "    <string name=\"${key}\" translatable=\"false\">${t}</string>\n")
      endif()
    endif()
  endforeach()
  string(APPEND x "</resources>\n")
  set(${out} "${x}" PARENT_SCOPE)
endfunction()

# fr -> values-fr, pt-BR -> values-pt-rBR, zh-Hans -> values-b+zh+Hans.
function(android_values_dir lang out)
  if(lang MATCHES "^([a-z]+)-([A-Z][A-Z]|[0-9][0-9][0-9])$")
    set(${out} "values-${CMAKE_MATCH_1}-r${CMAKE_MATCH_2}" PARENT_SCOPE)
  elseif(lang MATCHES "-")
    string(REPLACE "-" "+" b "${lang}")
    set(${out} "values-b+${b}" PARENT_SCOPE)
  else()
    set(${out} "values-${lang}" PARENT_SCOPE)
  endif()
endfunction()

android_resources("EN_" "${IDS}" ON _xml)
file(MAKE_DIRECTORY "${OUT_DIR}/values")
write_if_changed("${OUT_DIR}/values/strings.xml" "${_xml}")
foreach(_lang IN LISTS LANGS)
  android_resources("L_${_lang}_" "${LANG_${_lang}_IDS}" OFF _xml)
  android_values_dir("${_lang}" _dir)
  file(MAKE_DIRECTORY "${OUT_DIR}/${_dir}")
  write_if_changed("${OUT_DIR}/${_dir}/strings.xml" "${_xml}")
endforeach()
