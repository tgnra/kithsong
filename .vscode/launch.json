{
  // F5: build, then debug the app with gdb (C/C++ extension required). On Windows this uses
  // w64devkit's gdb; on Linux, gdb runs inside the flake's dev shell, so the app inherits its
  // library paths, GSettings schemas and icons.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kithsong (Windows, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-w64devkit/desktop/windows/kithsong.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "environment": [{ "name": "PATH", "value": "${env:W64DEVKIT}\\bin;${env:PATH}" }],
      "externalConsole": false,
      "preLaunchTask": "windows: build",
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Kithsong (Linux, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux-gtk/desktop/linux/kithsong",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "nix",
      "miDebuggerArgs": "develop ${workspaceFolder} -c gdb",
      "externalConsole": false,
      "preLaunchTask": "linux: build",
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
