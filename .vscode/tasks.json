{
  // Windows build tasks. Needs CMake, Ninja and llvm-mingw, which scripts\install-llvm-mingw.ps1
  // puts in ~\Tools, where the presets find it without PATH (set %LLVM_MINGW% if it's elsewhere).
  // The CMake and Ninja bundled with Visual Studio 2022 Build Tools are used as a fallback when
  // they are not on PATH. `windows: build (arm64)` cross-compiles for Windows on Arm; what it
  // builds won't run on an x64 PC.
  //
  // Linux build tasks. Run everything inside the flake's dev shell (`nix develop`), which
  // provides CMake, Ninja, GTK4, libadwaita and gdb. Ctrl+Shift+B runs `windows: build`;
  // on Linux use Tasks: Run Task -> `linux: build`.
  //
  // Wear OS tasks (Linux). android/scripts/android.sh finds the JDK and the emulator's
  // libraries through Android Studio; `wear: run` boots the Wear_OS_Small_Round AVD unless it
  // is already running (e.g. started from Studio's Device Manager).
  //
  // Android phone tasks work on both platforms: android.sh on Linux, android.ps1 on Windows
  // (which defaults JAVA_HOME to Android Studio's JDK and ANDROID_HOME to
  // %LOCALAPPDATA%\Android\Sdk). `android: run` cold-boots the Pixel_10 AVD (no Quick Boot
  // snapshot) unless it is running.
  //
  // `site: build` writes the website to site/dist. On Linux the dev shell provides Python,
  // Pillow and Markdown; on Windows it uses the venv in site/.venv (see site/README.md).
  "version": "2.0.0",
  "windows": {
    "options": {
      "env": {
        "PATH": "${env:PATH};C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin;C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja"
      }
    }
  },
  "tasks": [
    {
      "label": "windows: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "windows-x64"],
      "problemMatcher": []
    },
    {
      "label": "windows: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-x64"],
      "dependsOn": "windows: configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/build/windows-x64"]
      }
    },
    {
      "label": "windows: configure (arm64)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "windows-arm64"],
      "problemMatcher": []
    },
    {
      "label": "windows: build (arm64)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-arm64"],
      "dependsOn": "windows: configure (arm64)",
      "group": "build",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/build/windows-arm64"]
      }
    },
    {
      "label": "windows: run",
      "type": "shell",
      "command": "${workspaceFolder}/build/windows-x64/desktop/windows/kithsong.exe",
      "dependsOn": "windows: build",
      "problemMatcher": []
    },
    {
      // A fresh library and config folder in %TEMP%, deleted when the app exits.
      "label": "windows: run (scratch library)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\scripts\\run-windows-scratch.ps1",
        "${workspaceFolder}\\build\\windows-x64\\desktop\\windows\\kithsong.exe"
      ],
      "dependsOn": "windows: build",
      "problemMatcher": []
    },
    {
      "label": "windows: test",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "windows-x64"],
      "dependsOn": "windows: build",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "windows: musicbrainz ping",
      "type": "shell",
      "command": "${workspaceFolder}/build/windows-x64/core/tests/manual_mb_ping.exe",
      "dependsOn": "windows: build",
      "problemMatcher": []
    },
    {
      "label": "linux: configure",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "cmake", "--preset", "linux-gtk"],
      "problemMatcher": []
    },
    {
      "label": "linux: build",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "cmake", "--build", "--preset", "linux-gtk"],
      "dependsOn": "linux: configure",
      "group": "build",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/build/linux-gtk"]
      }
    },
    {
      "label": "linux: run",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "${workspaceFolder}/build/linux-gtk/desktop/linux/kithsong"],
      "dependsOn": "linux: build",
      "problemMatcher": []
    },
    {
      "label": "linux: test",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "ctest", "--preset", "linux-gtk"],
      "dependsOn": "linux: build",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "linux: musicbrainz ping",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "${workspaceFolder}/build/linux-gtk/core/tests/manual_mb_ping"],
      "dependsOn": "linux: build",
      "problemMatcher": []
    },
    {
      "label": "android: build",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": ["gradle", ":app:assembleDebug"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\android\\scripts\\android.ps1", "gradle", ":app:assembleDebug"]
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "android: emulator",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": ["emulator", "Pixel_10"],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\android\\scripts\\android.ps1", "emulator", "Pixel_10"]
      },
      "problemMatcher": []
    },
    {
      "label": "android: run",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": [
        "run",
        "Pixel_10",
        "${workspaceFolder}/android/app/build/outputs/apk/debug/app-debug.apk",
        "ng.kithso/ng.kithso.android.MainActivity"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\android\\scripts\\android.ps1",
          "run",
          "Pixel_10",
          "${workspaceFolder}\\android\\app\\build\\outputs\\apk\\debug\\app-debug.apk",
          "ng.kithso/ng.kithso.android.MainActivity"
        ]
      },
      "dependsOn": "android: build",
      "problemMatcher": []
    },
    {
      "label": "wear: build",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": ["gradle", ":wear:assembleDebug"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "wear: emulator",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": ["emulator", "Wear_OS_Small_Round"],
      "problemMatcher": []
    },
    {
      "label": "wear: run",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": [
        "run",
        "Wear_OS_Small_Round",
        "${workspaceFolder}/android/wear/build/outputs/apk/debug/wear-debug.apk",
        "ng.kithso/ng.kithso.wear.MainActivity"
      ],
      "dependsOn": "wear: build",
      "problemMatcher": []
    },
    {
      "label": "site: build",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "python", "-m", "ssg", "build"],
      "windows": {
        "command": "${workspaceFolder}\\site\\.venv\\Scripts\\python.exe",
        "args": ["-m", "ssg", "build"]
      },
      "options": { "cwd": "${workspaceFolder}/site" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
