{
  // Windows build tasks. Needs CMake, Ninja and w64devkit. If w64devkit's bin directory is
  // not on PATH, set the W64DEVKIT environment variable to its root (e.g. C:\w64devkit).
  // The CMake and Ninja bundled with Visual Studio 2022 Build Tools are used as a fallback
  // when they are not on PATH.
  //
  // Linux build tasks. Run everything inside the flake's dev shell (`nix develop`), which
  // provides CMake, Ninja, GTK4, libadwaita and gdb. Ctrl+Shift+B runs `windows: build`;
  // on Linux use Tasks: Run Task -> `linux: build`.
  //
  // Wear OS tasks (Linux). android/scripts/android.sh finds the JDK and the emulator's
  // libraries through Android Studio; `wear: run` boots the Wear_OS_Small_Round AVD unless it
  // is already running (e.g. started from Studio's Device Manager).
  "version": "2.0.0",
  "windows": {
    "options": {
      "env": {
        "PATH": "${env:W64DEVKIT}\\bin;${env:PATH};C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin;C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja"
      }
    }
  },
  "tasks": [
    {
      "label": "windows: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "windows-w64devkit"],
      "problemMatcher": []
    },
    {
      "label": "windows: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-w64devkit"],
      "dependsOn": "windows: configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/build/windows-w64devkit"]
      }
    },
    {
      "label": "windows: run",
      "type": "shell",
      "command": "${workspaceFolder}/build/windows-w64devkit/desktop/windows/musicapp.exe",
      "dependsOn": "windows: build",
      "problemMatcher": []
    },
    {
      "label": "windows: test",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "windows-w64devkit"],
      "dependsOn": "windows: build",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "windows: musicbrainz ping",
      "type": "shell",
      "command": "${workspaceFolder}/build/windows-w64devkit/core/tests/manual_mb_ping.exe",
      "dependsOn": "windows: build",
      "problemMatcher": []
    },
    {
      "label": "linux: configure",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "cmake", "--preset", "linux-gtk"],
      "problemMatcher": []
    },
    {
      "label": "linux: build",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "cmake", "--build", "--preset", "linux-gtk"],
      "dependsOn": "linux: configure",
      "group": "build",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/build/linux-gtk"]
      }
    },
    {
      "label": "linux: run",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "${workspaceFolder}/build/linux-gtk/desktop/linux/musicapp"],
      "dependsOn": "linux: build",
      "problemMatcher": []
    },
    {
      "label": "linux: test",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "ctest", "--preset", "linux-gtk"],
      "dependsOn": "linux: build",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "linux: musicbrainz ping",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "-c", "${workspaceFolder}/build/linux-gtk/core/tests/manual_mb_ping"],
      "dependsOn": "linux: build",
      "problemMatcher": []
    },
    {
      "label": "wear: build",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": ["gradle", ":wear:assembleDebug"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "wear: emulator",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": ["emulator", "Wear_OS_Small_Round"],
      "problemMatcher": []
    },
    {
      "label": "wear: run",
      "type": "shell",
      "command": "${workspaceFolder}/android/scripts/android.sh",
      "args": [
        "run",
        "Wear_OS_Small_Round",
        "${workspaceFolder}/android/wear/build/outputs/apk/debug/wear-debug.apk",
        "app.musicapp/app.musicapp.wear.MainActivity"
      ],
      "dependsOn": "wear: build",
      "problemMatcher": []
    }
  ]
}
