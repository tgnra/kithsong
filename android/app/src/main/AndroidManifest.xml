<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MusicBrainz lookups and LAN sync. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To tell whether sync is on Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS discovery needs a multicast lock. Sync opens its own sockets and uses no Wi-Fi
         scanning, Wi-Fi Direct or Aware, so it needs neither NEARBY_WIFI_DEVICES nor location. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Background playback: PlaybackService runs in the foreground while playing (API 28+
         needs FOREGROUND_SERVICE, API 34+ the permission for its type), and holds a wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The playback and sync notifications, API 33+. Asked for once, on first play, and
         from settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- SyncService runs in the foreground while a sync session or pairing is under way, and
         ImportService while an import is (API 34+: the dataSync type). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- No storage permission: import reads only what the user picks or shares, through the
         Storage Access Framework (OpenDocumentTree, OpenMultipleDocuments, and the intents
         below), and copies it into the app's own storage for the core. -->

    <application
        android:name=".KithsongApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kithsong">
        <!-- The launch screen theme until onCreate installs the splash screen, which then
             switches to Theme.Kithsong. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kithsong.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for a zip, e.g. a Bandcamp download in Files: imports it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <!-- The share sheet: a zip, or audio files, one or several. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
        <service
            android:name=".importer.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Exported so media controllers (system UI, Bluetooth, Android Auto) can connect. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
